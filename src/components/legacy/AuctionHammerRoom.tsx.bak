'use client';

import React, { useState } from 'react';
import { useAuction } from '@/context/AuctionContext';
import { formatCurrency, formatIncrement } from '@/lib/formatters';
import { calculateMaxSafeBid, getRecommendedIncrement } from '@/lib/auctionCalculations';
import {
  Gavel,
  CheckCircle,
  XCircle,
  RotateCcw,
  SkipForward,
  Play,
  Pause,
  Timer,
  Globe,
  Star,
  ShieldAlert,
  Sparkles,
  Trophy,
  ChevronRight,
  TrendingUp,
} from 'lucide-react';

export const AuctionHammerRoom: React.FC = () => {
  const {
    players,
    teams,
    settings,
    activePlayer,
    currentBid,
    currentBidTeam,
    hammerStage,
    placeBid,
    advanceHammerStage,
    markSold,
    markUnsold,
    undoLastAction,
    nextUpcomingPlayer,
    timerSeconds,
    isTimerRunning,
    toggleTimer,
    resetTimer,
  } = useAuction();

  const [customBidInput, setCustomBidInput] = useState<string>('');
  const [showCustomBid, setShowCustomBid] = useState<boolean>(false);

  if (!activePlayer) {
    return (
      <div className="flex flex-col items-center justify-center p-12 text-center bg-slate-900/60 rounded-2xl border border-slate-800 my-8">
        <Trophy className="w-16 h-16 text-amber-400 mb-4 animate-bounce" />
        <h2 className="text-2xl font-bold text-white mb-2">No Active Player Under the Hammer</h2>
        <p className="text-slate-400 max-w-md mb-6">
          All players have been auctioned or no player is currently selected. Pick a player from the Scouting Pool or start a new round!
        </p>
        <button
          onClick={nextUpcomingPlayer}
          className="px-6 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold transition-all shadow-lg shadow-amber-500/25 flex items-center space-x-2"
        >
          <span>Load Next Upcoming Player</span>
          <ChevronRight className="w-4 h-4" />
        </button>
      </div>
    );
  }

  const recIncrement = getRecommendedIncrement(currentBid, settings.bidLadder);
  const nextCalculatedBid = currentBidTeam ? currentBid + recIncrement : activePlayer.basePrice;

  // Custom bid submit
  const handleCustomBidSubmit = (e: React.FormEvent, teamId: string) => {
    e.preventDefault();
    const val = parseFloat(customBidInput);
    if (isNaN(val) || val <= currentBid) {
      alert(`Custom bid must be strictly greater than current bid (${formatCurrency(currentBid, settings.currency)})`);
      return;
    }
    // Convert to raw if entered in Lakhs or Crores
    let rawAmount = val;
    if (val < 100) {
      // User entered in Crores (e.g. 5.5 = 5.5 Cr)
      rawAmount = Math.round(val * 10000000);
    } else if (val < 10000) {
      // User entered in Lakhs (e.g. 75 = 75 L)
      rawAmount = Math.round(val * 100000);
    }

    placeBid(teamId, rawAmount);
    setCustomBidInput('');
    setShowCustomBid(false);
  };

  return (
    <div className="space-y-6">
      {/* Top Banner / Broadcast Headline */}
      <div className="relative overflow-hidden rounded-2xl bg-gradient-to-r from-slate-900 via-slate-850 to-slate-900 border border-slate-800 p-4 sm:p-6 shadow-2xl">
        <div className="absolute top-0 right-0 -mt-6 -mr-6 w-56 h-56 bg-amber-500/10 rounded-full blur-3xl pointer-events-none" />
        <div className="relative z-10 flex flex-col lg:flex-row items-center justify-between gap-4">
          <div className="flex items-center space-x-4">
            <div className="w-3 h-3 rounded-full bg-rose-500 animate-ping" />
            <div>
              <span className="text-xs uppercase tracking-widest font-bold text-amber-400">
                LOT #{activePlayer.id.replace('p-', '')} • {activePlayer.role.toUpperCase()}
              </span>
              <h1 className="text-2xl sm:text-3xl font-black text-white tracking-tight flex items-center gap-2">
                {activePlayer.name}
                {activePlayer.isOverseas && (
                  <span className="inline-flex items-center text-xs px-2 py-0.5 rounded-md font-semibold bg-sky-500/20 text-sky-400 border border-sky-500/30">
                    <Globe className="w-3 h-3 mr-1" />
                    Overseas ({activePlayer.country})
                  </span>
                )}
                {!activePlayer.isOverseas && (
                  <span className="inline-flex items-center text-xs px-2 py-0.5 rounded-md font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                    Domestic ({activePlayer.country})
                  </span>
                )}
              </h1>
            </div>
          </div>

          {/* Hammer Status Stage Badges */}
          <div className="flex items-center space-x-2">
            <div
              className={`px-3 py-1.5 rounded-xl border text-xs font-bold transition-all ${
                hammerStage === 0
                  ? 'bg-amber-500/20 border-amber-500/40 text-amber-300 ring-2 ring-amber-500/20'
                  : 'bg-slate-800/40 border-slate-700/40 text-slate-500'
              }`}
            >
              BIDDING ACTIVE
            </div>
            <div
              className={`px-3 py-1.5 rounded-xl border text-xs font-bold transition-all ${
                hammerStage === 1
                  ? 'bg-amber-500 text-slate-950 border-amber-400 font-extrabold animate-pulse'
                  : 'bg-slate-800/40 border-slate-700/40 text-slate-500'
              }`}
            >
              GOING ONCE
            </div>
            <div
              className={`px-3 py-1.5 rounded-xl border text-xs font-bold transition-all ${
                hammerStage === 2
                  ? 'bg-rose-500 text-white border-rose-400 font-extrabold animate-bounce'
                  : 'bg-slate-800/40 border-slate-700/40 text-slate-500'
              }`}
            >
              GOING TWICE
            </div>
            <div
              className={`px-3 py-1.5 rounded-xl border text-xs font-bold transition-all ${
                hammerStage === 3 || activePlayer.status === 'SOLD'
                  ? 'bg-emerald-500 text-slate-950 border-emerald-400 font-extrabold'
                  : activePlayer.status === 'UNSOLD'
                  ? 'bg-rose-900/60 text-rose-300 border-rose-700'
                  : 'bg-slate-800/40 border-slate-700/40 text-slate-500'
              }`}
            >
              {activePlayer.status === 'SOLD'
                ? 'SOLD'
                : activePlayer.status === 'UNSOLD'
                ? 'UNSOLD'
                : 'HAMMER'}
            </div>
          </div>
        </div>
      </div>

      {/* Main Grid: Player Profile + Live Bidding Cockpit */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
        {/* Left Column: Player Spotlight Card (5 cols) */}
        <div className="lg:col-span-5 bg-slate-900/80 backdrop-blur-sm rounded-2xl border border-slate-800 p-6 flex flex-col justify-between shadow-xl">
          <div>
            {/* Player Avatar & Meta */}
            <div className="flex items-start gap-4 mb-5">
              <div className="relative">
                <div className="w-24 h-24 rounded-2xl overflow-hidden bg-slate-800 border-2 border-slate-700/80 shadow-md">
                  {activePlayer.avatarUrl ? (
                    // eslint-disable-next-line @next/next/no-img-element
                    <img
                      src={activePlayer.avatarUrl}
                      alt={activePlayer.name}
                      className="w-full h-full object-cover"
                    />
                  ) : (
                    <div className="w-full h-full flex items-center justify-center font-black text-2xl text-slate-500">
                      {activePlayer.name.charAt(0)}
                    </div>
                  )}
                </div>
                {/* Rating Badge */}
                <div
                  title="Player Performance Rating"
                  className="absolute -bottom-2 -right-2 px-2 py-0.5 bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 font-black text-xs rounded-lg shadow-md"
                >
                  ★ {activePlayer.rating}
                </div>
              </div>

              <div className="flex-1 min-w-0">
                <div className="flex items-center justify-between">
                  <span className="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                    {activePlayer.country}
                  </span>
                  {activePlayer.priority && activePlayer.priority !== 'NONE' && (
                    <span className="inline-flex items-center text-[11px] px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 font-semibold border border-amber-500/30">
                      <Star className="w-3 h-3 mr-1 fill-amber-300" />
                      {activePlayer.priority} Target
                    </span>
                  )}
                </div>
                <h2 className="text-xl font-bold text-white truncate">{activePlayer.name}</h2>
                <div className="inline-block mt-1 px-2.5 py-0.5 rounded-md text-xs font-semibold bg-slate-800 text-amber-400 border border-slate-700">
                  {activePlayer.role}
                </div>

                <div className="mt-3 flex items-baseline gap-2">
                  <span className="text-xs text-slate-400">Base Price:</span>
                  <span className="text-base font-extrabold text-white">
                    {formatCurrency(activePlayer.basePrice, settings.currency)}
                  </span>
                </div>
              </div>
            </div>

            {/* Career Stats Grid */}
            <div className="bg-slate-950/60 rounded-xl p-3 border border-slate-800/80 mb-5">
              <span className="text-[11px] font-bold text-slate-400 uppercase tracking-wider block mb-2">
                Franchise Career Stats
              </span>
              <div className="grid grid-cols-3 gap-2 text-center">
                <div className="p-2 rounded-lg bg-slate-900 border border-slate-800">
                  <span className="text-[10px] text-slate-400 block">Matches</span>
                  <span className="text-sm font-bold text-white">{activePlayer.stats.matches ?? '--'}</span>
                </div>
                {activePlayer.stats.runs !== undefined && (
                  <div className="p-2 rounded-lg bg-slate-900 border border-slate-800">
                    <span className="text-[10px] text-slate-400 block">Runs</span>
                    <span className="text-sm font-bold text-amber-400">{activePlayer.stats.runs}</span>
                  </div>
                )}
                {activePlayer.stats.strikeRate !== undefined && (
                  <div className="p-2 rounded-lg bg-slate-900 border border-slate-800">
                    <span className="text-[10px] text-slate-400 block">Strike Rate</span>
                    <span className="text-sm font-bold text-emerald-400">{activePlayer.stats.strikeRate}</span>
                  </div>
                )}
                {activePlayer.stats.wickets !== undefined && (
                  <div className="p-2 rounded-lg bg-slate-900 border border-slate-800">
                    <span className="text-[10px] text-slate-400 block">Wickets</span>
                    <span className="text-sm font-bold text-rose-400">{activePlayer.stats.wickets}</span>
                  </div>
                )}
                {activePlayer.stats.economy !== undefined && (
                  <div className="p-2 rounded-lg bg-slate-900 border border-slate-800">
                    <span className="text-[10px] text-slate-400 block">Economy</span>
                    <span className="text-sm font-bold text-sky-400">{activePlayer.stats.economy}</span>
                  </div>
                )}
                {activePlayer.stats.average !== undefined && (
                  <div className="p-2 rounded-lg bg-slate-900 border border-slate-800">
                    <span className="text-[10px] text-slate-400 block">Average</span>
                    <span className="text-sm font-bold text-purple-400">{activePlayer.stats.average}</span>
                  </div>
                )}
              </div>
            </div>

            {/* Scout Notes */}
            {activePlayer.notes && (
              <div className="bg-amber-500/5 rounded-xl p-3 border border-amber-500/20 text-xs text-amber-200/90 leading-relaxed mb-4">
                <span className="font-bold text-amber-400 flex items-center gap-1.5 mb-1">
                  <Sparkles className="w-3.5 h-3.5 text-amber-400" />
                  Scouting Intelligence:
                </span>
                {activePlayer.notes}
              </div>
            )}
          </div>

          {/* Quick Player Switcher Footer */}
          <div className="pt-4 border-t border-slate-800 flex items-center justify-between text-xs text-slate-400">
            <span>
              Status:{' '}
              <span
                className={`font-bold ${
                  activePlayer.status === 'SOLD'
                    ? 'text-emerald-400'
                    : activePlayer.status === 'UNSOLD'
                    ? 'text-rose-400'
                    : 'text-amber-400'
                }`}
              >
                {activePlayer.status}
              </span>
            </span>
            <button
              onClick={nextUpcomingPlayer}
              className="flex items-center space-x-1 text-slate-300 hover:text-white transition-colors"
            >
              <span>Next Player</span>
              <SkipForward className="w-3.5 h-3.5" />
            </button>
          </div>
        </div>

        {/* Right Column: Live Bid Cockpit & Hammer Station (7 cols) */}
        <div className="lg:col-span-7 bg-slate-900/80 backdrop-blur-sm rounded-2xl border border-slate-800 p-6 flex flex-col justify-between shadow-xl">
          <div>
            {/* Top Bar: Current Bid Showcase + Timer */}
            <div className="flex flex-col sm:flex-row items-center justify-between gap-4 p-5 rounded-2xl bg-gradient-to-b from-slate-950 to-slate-900 border border-slate-800/90 shadow-inner mb-6">
              <div>
                <span className="text-xs uppercase font-extrabold tracking-widest text-slate-400 flex items-center gap-1.5">
                  <TrendingUp className="w-3.5 h-3.5 text-amber-400" />
                  Current Highest Bid
                </span>
                <div className="text-4xl sm:text-5xl font-black text-amber-400 tracking-tight mt-1">
                  {formatCurrency(currentBid, settings.currency)}
                </div>
                {/* Leading Team */}
                <div className="mt-2 flex items-center space-x-2">
                  <span className="text-xs text-slate-400">Winning Team:</span>
                  {currentBidTeam ? (
                    <div className="inline-flex items-center space-x-2 px-2.5 py-1 rounded-lg bg-slate-800 border border-slate-700">
                      <div
                        className="w-3 h-3 rounded-full shadow-sm"
                        style={{ backgroundColor: currentBidTeam.primaryColor }}
                      />
                      <span className="text-xs font-bold text-white">{currentBidTeam.name}</span>
                    </div>
                  ) : (
                    <span className="text-xs font-medium text-slate-500 italic">No bids placed yet</span>
                  )}
                </div>
              </div>

              {/* 15s Timer Ring / Bar */}
              <div className="flex flex-col items-center bg-slate-900/90 px-4 py-3 rounded-xl border border-slate-800">
                <div className="flex items-center space-x-2 mb-1">
                  <Timer className={`w-4 h-4 ${isTimerRunning ? 'text-rose-400 animate-spin' : 'text-slate-400'}`} />
                  <span className="text-xs font-bold text-slate-300">TIMER</span>
                </div>
                <div
                  className={`text-3xl font-black ${
                    timerSeconds <= 5 ? 'text-rose-500 animate-pulse' : 'text-white'
                  }`}
                >
                  00:{timerSeconds < 10 ? `0${timerSeconds}` : timerSeconds}
                </div>
                <div className="flex items-center space-x-1 mt-2">
                  <button
                    onClick={toggleTimer}
                    title={isTimerRunning ? 'Pause Timer' : 'Start Timer'}
                    className="p-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300"
                  >
                    {isTimerRunning ? <Pause className="w-3.5 h-3.5" /> : <Play className="w-3.5 h-3.5" />}
                  </button>
                  <button
                    onClick={() => resetTimer(15)}
                    title="Reset to 15s"
                    className="p-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300"
                  >
                    <RotateCcw className="w-3.5 h-3.5" />
                  </button>
                </div>
              </div>
            </div>

            {/* Quick Next Bid Preview Banner */}
            <div className="flex items-center justify-between px-4 py-2.5 rounded-xl bg-slate-950/40 border border-slate-800/80 mb-6 text-xs">
              <span className="text-slate-400">
                Recommended Increment: <strong className="text-amber-400">{formatIncrement(recIncrement, settings.currency)}</strong>
              </span>
              <span className="text-slate-300">
                Next Min Bid: <strong className="text-white font-bold">{formatCurrency(nextCalculatedBid, settings.currency)}</strong>
              </span>
            </div>

            {/* Hammer Control Action Pad */}
            <div className="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-6">
              {/* Going Once / Twice button */}
              <button
                onClick={advanceHammerStage}
                disabled={activePlayer.status === 'SOLD' || !currentBidTeam}
                className="flex items-center justify-center space-x-1.5 py-3 px-3 rounded-xl bg-gradient-to-r from-amber-600 to-amber-500 hover:from-amber-500 hover:to-amber-400 disabled:opacity-40 disabled:cursor-not-allowed text-slate-950 font-black text-xs sm:text-sm shadow-md transition-all"
              >
                <Gavel className="w-4 h-4 -rotate-45" />
                <span>
                  {hammerStage === 0 ? 'Going Once' : hammerStage === 1 ? 'Going Twice' : 'Sold Strike'}
                </span>
              </button>

              {/* Force SOLD */}
              <button
                onClick={markSold}
                disabled={activePlayer.status === 'SOLD' || !currentBidTeam}
                className="flex items-center justify-center space-x-1.5 py-3 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 disabled:opacity-40 disabled:cursor-not-allowed text-white font-extrabold text-xs sm:text-sm shadow-md transition-all"
              >
                <CheckCircle className="w-4 h-4" />
                <span>SOLD!</span>
              </button>

              {/* Mark UNSOLD */}
              <button
                onClick={markUnsold}
                disabled={activePlayer.status === 'SOLD'}
                className="flex items-center justify-center space-x-1.5 py-3 px-3 rounded-xl bg-slate-800 hover:bg-rose-900/60 hover:text-rose-200 border border-slate-700/60 disabled:opacity-40 disabled:cursor-not-allowed text-slate-300 font-bold text-xs sm:text-sm transition-all"
              >
                <XCircle className="w-4 h-4 text-rose-400" />
                <span>Unsold</span>
              </button>

              {/* Undo Last */}
              <button
                onClick={undoLastAction}
                className="flex items-center justify-center space-x-1.5 py-3 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700/60 text-slate-300 hover:text-white font-bold text-xs sm:text-sm transition-all"
              >
                <RotateCcw className="w-4 h-4" />
                <span>Undo</span>
              </button>
            </div>
          </div>

          {/* Quick Custom Bid Modal Toggle */}
          <div className="pt-2">
            <button
              onClick={() => setShowCustomBid(!showCustomBid)}
              className="text-xs text-slate-400 hover:text-amber-400 transition-colors flex items-center gap-1 font-semibold"
            >
              <span>{showCustomBid ? 'Hide Custom Bid Input' : 'Place Custom / Out-of-turn Bid Amount'}</span>
              <ChevronRight className={`w-3.5 h-3.5 transition-transform ${showCustomBid ? 'rotate-90' : ''}`} />
            </button>

            {showCustomBid && (
              <div className="mt-3 p-4 rounded-xl bg-slate-950 border border-slate-800 text-xs">
                <span className="text-slate-400 block mb-2 font-medium">
                  Enter custom bid (e.g. enter <strong>8.5</strong> for ₹8.5 Cr or <strong>85000000</strong>):
                </span>
                <div className="flex flex-wrap items-center gap-2">
                  <input
                    type="number"
                    step="any"
                    value={customBidInput}
                    onChange={(e) => setCustomBidInput(e.target.value)}
                    placeholder="Enter bid amount..."
                    className="flex-1 min-w-[140px] px-3 py-2 rounded-lg bg-slate-900 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 font-mono"
                  />
                  <div className="flex flex-wrap gap-1">
                    {teams.map((t) => (
                      <button
                        key={t.id}
                        onClick={(e) => handleCustomBidSubmit(e, t.id)}
                        className="px-2.5 py-1.5 rounded-lg text-white font-bold text-xs border border-slate-700 hover:border-amber-400 transition-all shadow-sm"
                        style={{ backgroundColor: t.primaryColor }}
                      >
                        {t.shortName}
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>

      {/* Team Bidding Paddles Interactive Board */}
      <div className="bg-slate-900/80 backdrop-blur-sm rounded-2xl border border-slate-800 p-6 shadow-xl">
        <div className="flex items-center justify-between mb-4">
          <div>
            <h3 className="text-lg font-bold text-white flex items-center gap-2">
              <Trophy className="w-5 h-5 text-amber-400" />
              Team Bidding Paddles
            </h3>
            <p className="text-xs text-slate-400">
              Click any team&apos;s paddle to raise the bid to{' '}
              <strong className="text-amber-400">{formatCurrency(nextCalculatedBid, settings.currency)}</strong>
            </p>
          </div>
          <span className="text-xs text-slate-400">
            {teams.length} Franchises In Contention
          </span>
        </div>

        {/* Responsive Grid of Teams */}
        <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
          {teams.map((team) => {
            const overseasCount = team.playerIds.reduce((acc, pId) => {
              const p = players.find((x) => x.id === pId);
              return acc + (p?.isOverseas ? 1 : 0);
            }, 0);

            const { maxBid, canBid, reason } = calculateMaxSafeBid(team, settings, activePlayer.isOverseas);
            const isLeading = currentBidTeam?.id === team.id;
            const isDisqualified = !canBid || (activePlayer.isOverseas && overseasCount >= team.maxOverseas);

            return (
              <div
                key={team.id}
                className={`relative rounded-xl p-4 border transition-all duration-200 flex flex-col justify-between ${
                  isLeading
                    ? 'bg-slate-900 border-amber-500 ring-2 ring-amber-500/30 shadow-lg'
                    : 'bg-slate-950/70 border-slate-800 hover:border-slate-700'
                }`}
              >
                {/* Team Accent Top Bar */}
                <div
                  className="absolute top-0 left-0 right-0 h-1 rounded-t-xl"
                  style={{ backgroundColor: team.primaryColor }}
                />

                <div>
                  <div className="flex items-center justify-between mt-1 mb-2">
                    <span
                      className="px-2 py-0.5 rounded text-[11px] font-black text-white"
                      style={{ backgroundColor: team.primaryColor }}
                    >
                      {team.shortName}
                    </span>
                    {isLeading && (
                      <span className="inline-flex items-center text-[10px] font-extrabold px-1.5 py-0.5 rounded bg-amber-500 text-slate-950">
                        HIGHEST BIDDER
                      </span>
                    )}
                  </div>

                  <h4 className="font-bold text-white text-sm truncate">{team.name}</h4>

                  {/* Purse Status */}
                  <div className="mt-2 text-xs space-y-1">
                    <div className="flex justify-between text-slate-400">
                      <span>Remaining Purse:</span>
                      <strong className="text-emerald-400">
                        {formatCurrency(team.remainingPurse, settings.currency, true)}
                      </strong>
                    </div>
                    <div className="flex justify-between text-slate-400">
                      <span>Max Safe Bid:</span>
                      <strong className={maxBid < nextCalculatedBid ? 'text-rose-400' : 'text-slate-200'}>
                        {formatCurrency(maxBid, settings.currency, true)}
                      </strong>
                    </div>
                    <div className="flex justify-between text-slate-400">
                      <span>Squad Count:</span>
                      <span className="text-slate-300">
                        {team.playerIds.length} / {team.maxSquadSize}
                      </span>
                    </div>
                    <div className="flex justify-between text-slate-400">
                      <span>Overseas:</span>
                      <span className="text-slate-300">
                        {overseasCount} / {team.maxOverseas}
                      </span>
                    </div>
                  </div>
                </div>

                {/* Paddle Button */}
                <div className="mt-4 pt-3 border-t border-slate-800/80">
                  {isDisqualified ? (
                    <div
                      title={reason || 'Disqualified from bidding'}
                      className="w-full py-2 px-2 rounded-lg bg-rose-950/40 border border-rose-900/60 text-rose-400 text-center text-[11px] font-bold flex items-center justify-center gap-1"
                    >
                      <ShieldAlert className="w-3.5 h-3.5" />
                      <span>{reason || 'Limit Reached'}</span>
                    </div>
                  ) : (
                    <button
                      onClick={() => placeBid(team.id)}
                      disabled={isLeading || activePlayer.status === 'SOLD'}
                      className={`w-full py-2.5 px-3 rounded-lg font-black text-xs flex items-center justify-center space-x-1.5 shadow-md transition-all ${
                        isLeading
                          ? 'bg-amber-500/20 text-amber-300 border border-amber-500/40 cursor-default'
                          : 'text-white hover:brightness-110 active:scale-95'
                      }`}
                      style={{
                        backgroundColor: !isLeading ? team.primaryColor : undefined,
                      }}
                    >
                      <Gavel className="w-3.5 h-3.5 -rotate-45" />
                      <span>{isLeading ? 'Leading Bid' : `BID ${formatCurrency(nextCalculatedBid, settings.currency, true)}`}</span>
                    </button>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  );
};
